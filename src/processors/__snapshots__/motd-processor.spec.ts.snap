// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`should render template with static message 1`] = `
"
<template id="motd-message">
<div class="docs-motd docs-motd--info">
    <span class="docs-motd__icon">
        <svg class="docs-icon docs-motd__icon-circle" focusable="false" aria-hidden="true">
            <use xlink:href="#docs-icon-circle"></use>
        </svg>
        <svg class="docs-icon docs-motd__icon-i" focusable="false" aria-hidden="true">
            <use xlink:href="#docs-icon-i"></use>
        </svg>
    </span><span data-bind="screenreader" class="sr-only"></span>
    <p data-bind="message"></p></div>
</template>


<div id="motd-container">
    
<div class="docs-motd docs-motd--info">
    <span class="docs-motd__icon">
        <svg class="docs-icon docs-motd__icon-circle" focusable="false" aria-hidden="true">
            <use xlink:href="#docs-icon-circle"></use>
        </svg>
        <svg class="docs-icon docs-motd__icon-i" focusable="false" aria-hidden="true">
            <use xlink:href="#docs-icon-i"></use>
        </svg>
    </span><span class="sr-only">Informationsmeddelande</span>
    <p>lorem ipsum</p></div>
</div>
"
`;

exports[`should render template without static message 1`] = `
"
<template id="motd-message">
<div class="docs-motd docs-motd--info">
    <span class="docs-motd__icon">
        <svg class="docs-icon docs-motd__icon-circle" focusable="false" aria-hidden="true">
            <use xlink:href="#docs-icon-circle"></use>
        </svg>
        <svg class="docs-icon docs-motd__icon-i" focusable="false" aria-hidden="true">
            <use xlink:href="#docs-icon-i"></use>
        </svg>
    </span><span data-bind="screenreader" class="sr-only"></span>
    <p data-bind="message"></p></div>
</template>


<div id="motd-container">
    </div>
"
`;
